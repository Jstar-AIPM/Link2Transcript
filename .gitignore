.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# 运行数据（含任务记录、中间音频、逐字稿产物、下载缓存）
# 特别注意：data/.session/ 里是登录凭据（B 站 Cookie），绝不能进版本控制。
# 这里整目录忽略，避免以后新增子目录（如 downloads / .session）又被漏掉。
data/
data-*/

models/

# 内部开发文档与截图：只留在本地，不进入公开仓库
# （文档本体在 开发文档/ 内有独立的本地 git 仓库，保留它们自己的历史）
# 内部开发文档：目录名可能带前缀点号（·开发文档），两种写法都要挡住
开发文档/
·开发文档/
·截图*/

# veFaaS 部署时生成的本地配置与产物
.vefaas/

# 前端部署产物（本地构建后上传，不入库）
frontend/artifact/

# 交接文档目录（含内部信息，不进公开仓库与部署包）
·交接文档-持续迭代/
