APP_ENV=development
DATA_DIR=./data
MAX_UPLOAD_MB=2048
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TASK_POLL_INTERVAL_SECONDS=2
TASK_MAX_WORKERS=1

# 内容时长上限（分钟）。本期三个平台（B 站/抖音/小红书）统一 120 = 2 小时；
# 超长内容由分窗转写支撑，上限是配置项，可随时上调（例如 360 = 6 小时）。
# 设为 0 表示不限制。链接任务在**下载前**用元信息判断，超限不会浪费下载流量。
MAX_MEDIA_MINUTES=120
MAX_DOWNLOAD_MB=1024

# 单次链接解析与下载的总超时（秒）
PLATFORM_DOWNLOAD_TIMEOUT_SECONDS=1800

# B 站 Cookie（可选，但字幕提取实际需要登录态）。
# 从浏览器开发者工具里复制**整行 `Cookie:` 请求头**（不要只抄 SESSDATA）：
#   F12 → Network → 刷新 bilibili.com → 点任意 api.bilibili.com 请求
#        → Headers → Request Headers → 右键 cookie 行 → Copy value
# 形如：
# BILIBILI_COOKIE=SESSDATA=xxxxxx; bili_jct=xxxxxx; DedeUserID=xxxxxx; buvid3=xxxxxx
#
# ⚠️ B 站会在会话续期时**轮换 SESSDATA，旧票立即作废**（用户端无感），
#    表现就是线上「登录态已失效」并自动降级为语音转写（明显更慢）。
#    2026-09-28 真实发生过一次。所以：① 抄完尽量不要再触发该账号的登录动作；
#    ② 失效时按同样方式重新复制即可。
# 该值只从后端环境变量读取，不进入前端、日志或 Git。
BILIBILI_COOKIE=

# 小红书登录 Cookie（可选，但机房 IP 实际需要）。
# 实测：从云函数出口访问小红书会被判定为登录墙（拿不到视频流）；
# 配上登录 Cookie 后可正常解析。从浏览器开发者工具复制 Cookie 请求头中的
# web_session / a1 / webId 等字段，形如：
# XIAOHONGSHU_COOKIE=web_session=xxxxxx; a1=xxxxxx; webId=xxxxxx
# 该值只从后端环境变量读取，不进入前端、日志或 Git。
XIAOHONGSHU_COOKIE=

# 可选限速（KB/s），留空表示不限速
PLATFORM_RATE_LIMIT_KBPS=

# 链接链路后端：api = 走 B 站 API（线上默认；机房 IP 不会被 HTML 页面的 412 风控挡住）
#                ytdlp = 走 yt-dlp（抓 HTML，本地网络环境正常时可用）
PLATFORM_BACKEND=api

# 代理地址（可选）：B 站不需要；小红书在机房 IP 上需要 Cookie 或换出口时使用
PLATFORM_PROXY=

# 转写速度估算系数（倍实时），用于向用户展示预计剩余时间
TRANSCRIPTION_SPEED_FACTOR=4

# ---------------------------------------------------------------------
# 阶段 3：转写过程实时反馈
# ---------------------------------------------------------------------

# 转写进度写回任务记录的节流间隔（秒）。片段本身是即时落盘的，
# 这里节流的是“任务记录”的整体原子重写次数，避免数千次小写入。
PROGRESS_PERSIST_INTERVAL_SECONDS=1

# 服务重启后是否自动续跑有进度的任务（从断点续写，不重跑已完成部分）
RESUME_ON_STARTUP=true

# 断点续写时与检查点的重叠秒数，避免断点正好落在词中间导致开头丢字
RESUME_OVERLAP_SECONDS=2

# 阶段 3.5：长内容分窗转写。内容时长超过该窗口秒数时，改为按窗口切片逐段转写：
# 内存占用与总时长解耦（6 小时内容不再需要约 1.3 GB 的解码数组），
# 中断最多丢一个窗口。0 = 关闭，退化为整段一次转写。
# 窗口之间重叠 TRANSCRIBE_WINDOW_OVERLAP_SECONDS 秒，按时间戳去重，避免切在词中间丢字。
TRANSCRIBE_WINDOW_SECONDS=1200
TRANSCRIBE_WINDOW_OVERLAP_SECONDS=5

# 单任务片段数上限，防止异常输入打爆磁盘
MAX_SEGMENTS_PER_TASK=200000

# ---------------------------------------------------------------------
# 阶段 6：上线部署（火山引擎 veFaaS + 对象存储 + 邀请码登录）
# ---------------------------------------------------------------------

# 线上不支持上传本地文件（平台同步调用请求体上限 16 MiB）；线上部署时设为 false
ENABLE_LOCAL_UPLOAD=true

# 业务数据备份（函数实例除 /tmp 外只读，且 /tmp 易失，必须备份）
# disabled = 不备份（本地开发）；local = 备份到本机目录；tos = 火山引擎对象存储
STORAGE_PROVIDER=disabled
# STORAGE_LOCAL_DIR=./data-backup
# TOS_BUCKET=
# TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=

# 备份周期（秒）与产物保留期（天，0 = 不清理）
BACKUP_INTERVAL_SECONDS=300
RETENTION_DAYS=0

# ---------------------------------------------------------------------
# 阶段 6B：邀请码登录（线上必须配置）
# ---------------------------------------------------------------------

# 是否强制登录。留空时：APP_ENV=prod 自动强制，本地开发不强制
# REQUIRE_AUTH=true

# 管理员码：永久有效、不限次数。只从这个环境变量读取，不落库、不出现在接口返回值里
# ADMIN_INVITE_CODE=换成一串只有你知道的码

# 普通邀请码规则（默认即为产品规则：30 天 / 20 次）
# INVITE_VALID_DAYS=30
# INVITE_MAX_USES=20

# 每个邀请码每天可提交的任务数上限（0 = 不限制；管理员码不受限）。
# 与上面的「30 天 / 20 次登录」是两件事：那个限登录次数，这个限任务数量。
MAX_TASKS_PER_CODE_PER_DAY=30

# 线上必须设置：强制邀请码登录 + 数据目录指向 /tmp（veFaaS 除 /tmp 外只读）
# APP_ENV=prod
# DATA_DIR=/tmp/data
