APP_ENV=development
DATA_DIR=./data
MAX_UPLOAD_MB=2048
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TASK_POLL_INTERVAL_SECONDS=2
TASK_MAX_WORKERS=1

# 长任务控制：不限制内容时长，体积仅做兜底
# MAX_MEDIA_MINUTES=0 表示不限制（默认）。2026-09-22 实测：字幕路径秒级完成、
# 转写路径约 3–4 倍实时，因此不再按时长限制，长内容（如 4-5 小时播客）正常跑完。
# 若后续出现资源或运营问题，把它改回正整数即可重新启用限制。
MAX_MEDIA_MINUTES=0
MAX_DOWNLOAD_MB=1024

# 单次链接解析与下载的总超时（秒）
PLATFORM_DOWNLOAD_TIMEOUT_SECONDS=1800

# B 站 Cookie（可选，但字幕提取实际需要登录态）。
# 从浏览器开发者工具复制 Cookie 请求头中的 SESSDATA 等字段，形如：
# BILIBILI_COOKIE=SESSDATA=xxxxxx; bili_jct=xxxxxx
# 该值只从后端环境变量读取，不进入前端、日志或 Git。
BILIBILI_COOKIE=

# 可选限速（KB/s），留空表示不限速
PLATFORM_RATE_LIMIT_KBPS=

# 预留：代理地址（B 站不需要；后续接入 YouTube 等平台时使用）
PLATFORM_PROXY=

# 转写速度估算系数（倍实时），用于向用户展示预计剩余时间
TRANSCRIPTION_SPEED_FACTOR=4
