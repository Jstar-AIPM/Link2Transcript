APP_ENV=development
DATA_DIR=./data
MAX_UPLOAD_MB=2048
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TASK_POLL_INTERVAL_SECONDS=2
TASK_MAX_WORKERS=1

# 内容时长上限（分钟）。默认 360 = 6 小时，用于挡住过于夸张的输入；
# 4-5 小时的播客正常支持。设为 0 表示不限制。
# 链接任务在**下载前**用元信息判断，超限不会浪费下载流量。
MAX_MEDIA_MINUTES=360
MAX_DOWNLOAD_MB=1024

# 单次链接解析与下载的总超时（秒）
PLATFORM_DOWNLOAD_TIMEOUT_SECONDS=1800

# B 站 Cookie（可选，但字幕提取实际需要登录态）。
# 从浏览器开发者工具复制 Cookie 请求头中的 SESSDATA 等字段，形如：
# BILIBILI_COOKIE=SESSDATA=xxxxxx; bili_jct=xxxxxx
# 该值只从后端环境变量读取，不进入前端、日志或 Git。
BILIBILI_COOKIE=

# 可选限速（KB/s），留空表示不限速
PLATFORM_RATE_LIMIT_KBPS=

# 预留：代理地址（B 站不需要；后续接入 YouTube 等平台时使用）
PLATFORM_PROXY=

# 转写速度估算系数（倍实时），用于向用户展示预计剩余时间
TRANSCRIPTION_SPEED_FACTOR=4

# ---------------------------------------------------------------------
# 阶段 3：转写过程实时反馈
# ---------------------------------------------------------------------

# 转写进度写回任务记录的节流间隔（秒）。片段本身是即时落盘的，
# 这里节流的是“任务记录”的整体原子重写次数，避免数千次小写入。
PROGRESS_PERSIST_INTERVAL_SECONDS=1

# 服务重启后是否自动续跑有进度的任务（从断点续写，不重跑已完成部分）
RESUME_ON_STARTUP=true

# 断点续写时与检查点的重叠秒数，避免断点正好落在词中间导致开头丢字
RESUME_OVERLAP_SECONDS=2

# 单任务片段数上限，防止异常输入打爆磁盘
MAX_SEGMENTS_PER_TASK=200000

# ---------------------------------------------------------------------
# 阶段 6：上线部署（火山引擎 veFaaS + 对象存储 + 邀请码登录）
# ---------------------------------------------------------------------

# 线上不支持上传本地文件（平台同步调用请求体上限 16 MiB）；线上部署时设为 false
ENABLE_LOCAL_UPLOAD=true

# 业务数据备份（函数实例除 /tmp 外只读，且 /tmp 易失，必须备份）
# disabled = 不备份（本地开发）；local = 备份到本机目录；tos = 火山引擎对象存储
STORAGE_PROVIDER=disabled
# STORAGE_LOCAL_DIR=./data-backup
# TOS_BUCKET=
# TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=

# 备份周期（秒）与产物保留期（天，0 = 不清理）
BACKUP_INTERVAL_SECONDS=300
RETENTION_DAYS=0

# 线上环境：APP_ENV=prod 时强制邀请码登录（阶段 6 实现）
# ADMIN_INVITE_CODE=            # 管理员码：永久有效、不限次数
# APP_ENV=prod
